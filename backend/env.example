# ─────────────────────────────────────────────
#  GIDEON PORTFOLIO — Contact Backend Config
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=3000

# ── Gmail (Email Notifications) ───────────────
# Your Gmail address (used to SEND emails)
EMAIL_USER=yourgmail@gmail.com

# Gmail App Password — NOT your real password!
# Steps: Google Account → Security → 2-Step Verification → App Passwords
# Choose "Mail" + "Other (Custom name)" → Copy the 16-char password here
EMAIL_PASS=xxxx xxxx xxxx xxxx

# The email address that will RECEIVE notifications (can be the same as above)
NOTIFY_EMAIL=yourgmail@gmail.com

# ── Telegram Notifications ────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnOPQRstuvWXYZ

# Step 2: Get your Chat ID:
#   a) Message your bot anything
#   b) Open: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   c) Find "chat" → "id" in the response — paste it here
TELEGRAM_CHAT_ID=123456789
